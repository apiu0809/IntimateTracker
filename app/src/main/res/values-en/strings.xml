    <!-- Privacy -->
    <string name="privacy_title">Data &amp; privacy</string>
    <string name="privacy_intro">This app is local-first. Here is where your data lives, when it goes online, and how to take it with you or delete it.</string>
    <string name="privacy_data_title">Where data lives</string>
    <string name="privacy_data_body">Records, dictionaries, partners, photos and settings live in the app\'s private storage. There is no account and nothing is uploaded to any server.</string>
    <string name="privacy_network_title">When it goes online</string>
    <string name="privacy_network_body">The app is fully offline by default. It only connects to a server you enter under “WebDAV sync” and sync manually; the address and account stay on this device and the password is encrypted.</string>
    <string name="privacy_permission_title">Permissions &amp; third parties</string>
    <string name="privacy_permission_body">No location or contacts permission. Photos are read through the system picker. No ads or analytics SDKs are included.</string>
    <string name="privacy_crash_title">Crash logs</string>
    <string name="privacy_crash_body">On a crash, up to five logs are written locally and never uploaded. View or clear them in About → Crash logs.</string>
    <string name="privacy_delete_title">Export &amp; delete</string>
    <string name="privacy_delete_body">Export a zip (database + photos) at any time, or erase all data from About. Erasing cannot be undone.</string>

