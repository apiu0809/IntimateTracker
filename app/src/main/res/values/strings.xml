    <!-- 隐私说明 -->
    <string name="privacy_title">数据与隐私</string>
    <string name="privacy_intro">这是一款本地优先的应用。下面说明数据存在哪里、什么时候会联网，以及如何带走或删除它。</string>
    <string name="privacy_data_title">数据存放在哪</string>
    <string name="privacy_data_body">记录、字典、伴侣、照片与设置都保存在应用的私有目录里。没有账号，也不会同步到任何服务器。</string>
    <string name="privacy_network_title">什么时候联网</string>
    <string name="privacy_network_body">默认完全离线。只有你在「WebDAV 同步」里填写服务器并手动同步时，应用才会连接该服务器；地址与账号只存在本机，密码加密保存。</string>
    <string name="privacy_permission_title">权限与第三方</string>
    <string name="privacy_permission_body">不申请定位、通讯录等权限；照片通过系统选择器读取；未集成广告或统计 SDK。</string>
    <string name="privacy_crash_title">崩溃日志</string>
    <string name="privacy_crash_body">崩溃时只在本机写入最多 5 份日志，不上传；可在「关于 → 崩溃日志」查看或清空。</string>
    <string name="privacy_delete_title">导出与删除</string>
    <string name="privacy_delete_body">可随时导出 zip（数据库 + 照片），或在「关于」里清空全部数据；清空不可恢复。</string>

